        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Die ausgewählte Instanz ist kein UniFi Access Controller"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "Bitte ein Grundriss-Bild auswählen"
        }
    ]
}
